# BeluGANG Events Bot — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs

# Token du bot Discord principal (OBLIGATOIRE)
DISCORD_TOKEN=ton_token_ici

# Token de l'instance SCEMER (optionnel)
# SCEMER_TOKEN=token_scemer_ici

# Chemin vers la base de données SQLite (optionnel, défaut : data/belugagang.db)
# DB_PATH=data/belugagang.db
